PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Optional, one-time bootstrap for a new empty database. Remove after initialization.
INITIAL_ACCOUNTS_JSON=

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ovh-email-address@example.com
SMTP_PASSWORD=your-ovh-mailbox-password
# SMTP_USER is used as the sender address; this value supplies its display name.
SMTP_FROM="Org'atelier <your-ovh-email-address@example.com>"